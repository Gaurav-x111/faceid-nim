#!/bin/sh
set -e

case "$1" in
  purge)
    # purge means purge: the templates and the master key go too.
    rm -rf /var/lib/faceid-nim /var/log/faceid-nim /etc/faceid-nim
    deluser --system faceid >/dev/null 2>&1 || true
    ;;
  remove)
    # Keep enrolled data on a plain remove so reinstalling does not
    # force everyone to re-enroll. Use `apt purge` to erase it.
    ;;
esac

systemctl daemon-reload || true

#DEBHELPER#
exit 0
