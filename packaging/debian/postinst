#!/bin/sh
# postinst -- create the worker user, lay out the data directories,
# register the PAM profile (still disabled), check the models, start
# the services.
#
# The one thing this script must never do is enable face unlock.
# Installing a package should not change how a machine authenticates;
# the user opts in from the Face Unlock app, behind a polkit prompt.
set -e

MODEL_DIR=/var/lib/faceid-nim/models
LIBEXEC=/usr/libexec/faceid-nim

case "$1" in
  configure)
    # --- system user -------------------------------------------------
    if ! getent passwd faceid >/dev/null; then
      adduser --system --group --no-create-home \
              --home /var/lib/faceid-nim \
              --shell /usr/sbin/nologin faceid
    fi
    # The worker needs the camera and nothing else.
    adduser faceid video >/dev/null 2>&1 || true

    # --- directories -------------------------------------------------
    # The state root is 0711 (traverse-only): models are world-readable
    # public model files that the unprivileged worker must reach, while
    # the master key and templates stay behind 0600/0700 on their own
    # leaves and the root itself can never be listed.
    install -d -o root -g root -m 0711 /var/lib/faceid-nim
    install -d -o root -g root -m 0755 "$MODEL_DIR"
    install -d -o root -g root -m 0700 /var/log/faceid-nim
    install -d -o root -g root -m 0755 /etc/faceid-nim

    # --- default config ----------------------------------------------
    if [ ! -f /etc/faceid-nim/config.toml ]; then
      # Detect the cameras before writing the config, so a fresh install
      # has a working camera with nothing asked of the user. The probe
      # prints `key = "value"` lines for the devices it actually found;
      # if it fails or finds nothing, we fall back to the documented
      # /dev/video0 default and the app re-resolves on first run.
      CAM_LINES=""
      if [ -x "$LIBEXEC/venv/bin/python3" ]; then
        CAM_LINES="$("$LIBEXEC/venv/bin/python3" -m faceid_vision.cameras \
                      --config-lines 2>/dev/null || true)"
      fi
      if [ -z "$CAM_LINES" ]; then
        CAM_LINES='camera = "/dev/video0"'
        echo "faceid-nim: could not auto-detect a camera; defaulting to"
        echo "            /dev/video0. The app will re-detect on first run."
      fi

      cat > /etc/faceid-nim/config.toml <<CFG
# faceid-nim configuration.
#
# Face unlock is OFF until you turn it on in the Face Unlock app.
enabled = false

# off | light | heavy
#   light: spoof cues veto an unlock
#   heavy: additionally requires positive evidence of a real 3D face
strictness = "light"

# rgb | ir | both | hybrid | auto
#   auto: measure the room light per scan and pick the sensor (dark -> IR,
#         lit -> RGB). Needs a second, infrared template set, which
#         enrollment collects for you when both sensors exist.
mode = "auto"

# There is no correct universal threshold. Measure yours with
# eval/far_frr.py and replace this before trusting an unlock.
tau = 0.40
vote_k = 3
vote_n = 5

# Keep this short: PAM's auth conversation is sequential, so the
# password box is usually unusable until the face attempt finishes.
scan_timeout_ms = 4000
max_failures = 5
lockout_secs = 60
require_attention = true

# Cameras detected at install time. The app re-detects and can override
# these at any time.
$CAM_LINES

# The worker binds inside its own runtime subdirectory, which is the
# only place it is allowed to write.
worker_socket = "/run/faceid-nim/worker/vision.sock"
auth_socket = "/run/faceid-nim/auth.sock"
CFG
      chmod 0644 /etc/faceid-nim/config.toml
    fi

    # --- models ------------------------------------------------------
    # Model files are not shipped in the .deb: their licenses differ
    # from the code's, and some are non-commercial research use only.
    #
    # We FETCH them here rather than printing an instruction to run a
    # command. A package that installs into a state where the feature
    # cannot work, and then tells the user to fix it, is not installed.
    #
    # Every failure below is non-fatal by design: a laptop with no
    # network at install time must still finish booting, and
    # faceid-nim-fetch-models.service retries on every boot until the
    # models land. Face unlock degrades to "unavailable" meanwhile; it
    # must never be able to lock anyone out.
    MODELS_OK=0
    if [ -x "$LIBEXEC/verify-models" ] && [ -x "$LIBEXEC/fetch-models" ]; then
        if "$LIBEXEC/verify-models" --quiet; then
            MODELS_OK=1
        else
            echo "faceid-nim: fetching face recognition models..."
            if "$LIBEXEC/fetch-models" >/dev/null 2>&1; then
                MODELS_OK=1
            else
                echo "faceid-nim: could not download the models."
                echo "            This is usually no network at install time."
                echo "            Retrying automatically on every boot; you can"
                echo "            also run:  sudo faceid-nim fetch-models"
            fi
        fi
    fi

    # Report the real state, not a to-do list. Liveness features that
    # are not running are named as such: a build whose blink/planarity
    # checks silently did nothing was exactly the failure this wording
    # exists to prevent.
    if [ "$MODELS_OK" -eq 1 ]; then
        MODELS_LINE="models    : ready"
    else
        MODELS_LINE="models    : NOT INSTALLED yet (retrying on boot)"
    fi

    LIVE=""
    if [ -f /var/lib/faceid-nim/models/face_landmarker.task ]; then
        LIVE="landmarks : blink / 3D / attention checks active"
    else
        LIVE="landmarks : unavailable (heavy strictness cannot be satisfied)"
    fi
    ANTI="anti-spoof: no ML model (screen/print/IR cues still active)"
    if [ -f /var/lib/faceid-nim/models/minifasnet_v2.onnx ]; then
        ANTI="anti-spoof: active"
    fi

    # --- accelerator --------------------------------------------------
    if [ -e /dev/dri/renderD128 ] || [ -e /dev/nvidia0 ] || [ -e /dev/kfd ]; then
        ACCEL="device   : GPU device present"
    else
        ACCEL="device   : CPU only"
    fi

    # --- camera ------------------------------------------------------
    CAM_LINE="camera   : not probed yet (the app detects it on first run)"
    for n in 0 1 2 3 4 5 6 7; do
        if [ -e "/dev/video$n" ]; then
            CAM_LINE="camera   : /dev/video$n present (the app picks RGB/IR)"
            break
        fi
    done

    # --- GPU sandbox -------------------------------------------------
    # Only widens the worker's device access when hardware is actually
    # present. See packaging/scripts/gpu-devices.
    [ -x "$LIBEXEC/gpu-devices" ] && "$LIBEXEC/gpu-devices" >/dev/null 2>&1 || true

    # --- source-install fallback -------------------------------------
    # `make install` puts the same files in the same places but does not
    # run this script, so tolerate a layout that is already correct.
    if [ ! -x "$LIBEXEC/faceid-nimd" ]; then
        echo "faceid-nim: warning, $LIBEXEC/faceid-nimd not found."
        echo "            If you installed from source, run 'sudo make install'."
    fi

    # --- GTK app plumbing --------------------------------------------
    if command -v glib-compile-schemas >/dev/null 2>&1; then
        glib-compile-schemas /usr/share/glib-2.0/schemas || true
    else
        # The gschema is installed but uncompiled without this package.
        # The app does not read it (it keeps prefs in its own JSON), so
        # this is cosmetic -- say so rather than failing silently.
        echo "faceid-nim: note: glib-compile-schemas not found; the GSettings"
        echo "            schema is installed but not compiled. Install"
        echo "            libglib2.0-bin if anything else reads it."
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -qtf /usr/share/icons/hicolor || true
    fi
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi

    # --- PAM ----------------------------------------------------------
    # Registers the profile as *available*. Default: no keeps it out of
    # the stack until the app enables it.
    pam-auth-update --package

    # --- services -----------------------------------------------------
    systemctl daemon-reload || true
    systemctl enable --now faceid-nim-fetch-models.service || true
    systemctl enable --now faceid-nimd.service || true
    systemctl enable --now faceid-vision.service || true

    cat <<MSG

faceid-nim installed. Face unlock is DISABLED.

  $MODELS_LINE
  $LIVE
  $ANTI
  $ACCEL
  $CAM_LINE

Next: open "Face Unlock", enroll, then enable it there.
On Wayland, log out and back in once so GNOME loads the lock-screen pill.

Check state any time with:  faceid-nim status
Your password always works.
MSG
    ;;
esac

#DEBHELPER#
exit 0
