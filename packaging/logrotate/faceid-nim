# The audit log records who unlocked what and when. It never contains
# embeddings, similarity scores or frames, but it is still an access
# log for a biometric system: keep it root-only across rotations.
#
# The `size` caps below are the disk-exhaustion bound (round-2 audit):
# every refused attempt logs a line and refusals complete instantly, so
# one local client sustained ~10k lines/s (1.7 MiB/s). Weekly rotation
# alone would let that reach ~1 TiB. With `size`, logrotate rolls the
# file early instead, bounding the directory to (size x rotate) no
# matter how fast lines arrive.
/var/log/faceid-nim/audit.log {
    weekly
    size 10M
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    create 0600 root root
}

/var/log/faceid-nim/timeline.jsonl {
    weekly
    size 1M
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    create 0600 root root
}
