<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>faceid-nim</vendor>
  <vendor_url>https://github.com/Gaurav-x111/faceid-nim</vendor_url>

  <!-- auth_self is the whole point: enrolling requires the account
       password, so someone sitting at your unlocked laptop cannot add
       their own face to your account. -->
  <action id="org.faceidnim.enroll">
    <description>Enroll a face for unlocking</description>
    <message>Authentication is required to enroll a face</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>

  <!-- The preview pipe carries live camera frames, so watching it
       needs the same re-auth as enrolling. Without this, any local
       user could observe the camera without proving who they are. -->
  <action id="org.faceidnim.preview">
    <description>View the face unlock camera preview</description>
    <message>Authentication is required to view the camera preview</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>

  <action id="org.faceidnim.settings">
    <description>Change face unlock settings</description>
    <message>Authentication is required to change face unlock settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>

  <!-- H3/O1/O5: security-sensitive settings (enabled state, threshold,
       liveness strictness, vote counts, allowed PAM services, lockout
       policy) need an admin password. The daemon's SetSettings demands
       this action whenever a protected key actually changes, so the
       general settings action above cannot be used to smuggle them
       through a weaker policy. -->
  <action id="org.faceidnim.settings-secure">
    <description>Change security-sensitive face unlock settings</description>
    <message>Administrator authentication is required to change security-sensitive face unlock settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <!-- H9: deleting your own biometric data needs your own password
       (auth_self) — promptless (yes) was too weak, auth_admin would
       make wiping your own face harder than creating it. -->
  <action id="org.faceidnim.delete">
    <description>Remove enrolled face data</description>
    <message>Authentication is required to remove face data</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>

  <!-- H9: enabling/disabling PAM integration changes how the machine
       authenticates, so it needs an admin password. -->
  <action id="org.faceidnim.enable">
    <description>Enable or disable face unlock in PAM</description>
    <message>Administrator authentication is required to change PAM face unlock</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <!-- A diagnostic scan still opens the camera, so it needs a polkit
       decision — but the Test button must stay smooth, so the local
       active session is allowed without a password prompt. Remote and
       inactive sessions are denied: the camera must not open for
       someone not at this machine. (1B-2: TestScan used to run for any
       same-uid caller with no authorization check at all.) -->
  <action id="org.faceidnim.test">
    <description>Run a face unlock test scan</description>
    <message>Authentication is required to run a face unlock test scan</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
