#!/bin/sh
# faceid-nim-gpu-devices -- widen the worker's device sandbox, but only
# when this machine actually has an accelerator.
#
# Generated into /run/faceid-nim/ at install time and consumed as a
# systemd drop-in for faceid-vision.service. Run by the provisioning
# step; safe to run repeatedly.
#
# Why a drop-in at all: faceid-vision.service ships
# `DevicePolicy=closed` with only char-video4linux allowed, which is
# exactly right on a laptop with a webcam and nothing else. It also means
# /dev/dri, /dev/nvidia* and /dev/kfd are unreachable, so a CUDA or ROCm
# session would die at provider init even if one were ever selected.
#
# Why it is conditional: widening a sandbox for hardware that is not
# there is pure attack surface. On a machine with no accelerator this
# script writes nothing and the unit keeps its tighter default.
set -eu

CONF_DIR=/run/faceid-nim/systemd
DROPIN_DIR=/etc/systemd/system/faceid-vision.service.d
STATE=/run/faceid-nim/gpu-devices

# DeviceAllow is matched on the *device node type*, not a path, so a
# glob like /dev/nvidia* is not expressible here. These are the character
# device types a GPU stack actually needs.
DEV_ALLOWS='DeviceAllow=char-video4linux rw
DeviceAllow=char-dri rw
DeviceAllow=char-nvidia-tty rw
DeviceAllow=char-nvidia-uvm rw'

# The CUDA/ROCm drivers need ioctls and mapped memory outside the
# @system-service set; without this they get EPERM and the provider
# fails at init. CapabilityBoundingSet stays EMPTY: device access plus
# the existing sandbox is enough, and adding capabilities is not.
SYSCALLS='SystemCallFilter=@system-service @aio @signal @chown @setuid @setgid @resource'

have_accel() {
    [ -e /dev/dri/renderD128 ] && return 0
    [ -d /dev/nvidiactl ] && return 0
    [ -e /dev/nvidia0 ] && return 0
    [ -e /dev/kfd ] && return 0
    return 1
}

mkdir -p "$CONF_DIR" "$DROPIN_DIR"

if ! have_accel; then
    # No accelerator: make sure a previously-generated drop-in (e.g. the
    # user eGPU was unplugged) cannot linger and keep the sandbox wide.
    rm -f "$DROPIN_DIR/10-gpu-devices.conf" "$STATE"
    echo "faceid-nim: no GPU device found; worker sandbox unchanged"
    exit 0
fi

cat > "$DROPIN_DIR/10-gpu-devices.conf" <<EOF
# Generated by faceid-nim-gpu-devices. Regenerated on every install and
# on every boot; safe to delete, it comes back only if a GPU is present.
[Service]
$DEV_ALLOWS
$SYSCALLS
EOF

chmod 0644 "$DROPIN_DIR/10-gpu-devices.conf"
printf 'gpu\n' > "$STATE"

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
fi

echo "faceid-nim: GPU device access granted to the vision worker"
echo "            ($DROPIN_DIR/10-gpu-devices.conf)"
