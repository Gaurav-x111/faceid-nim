[Unit]
Description=faceid-nim privileged face unlock daemon
Documentation=https://github.com/Gaurav-x111/faceid-nim
After=dbus.service
Requires=dbus.service
# Bring the vision worker along on start. The worker unit
# Requires/After/PartOf this unit, so it is stopped and restarted with
# the daemon too -- without this Wants, a plain `stop` + `start` of the
# daemon leaves the worker dead and the app reports the worker as
# unreachable.
Wants=faceid-vision.service

[Service]
Type=simple
ExecStart=/usr/libexec/faceid-nim/faceid-nimd
Restart=on-failure
RestartSec=2s

# RuntimeDirectory gives us /run/faceid-nim as root:root 0755, which is
# right for auth.sock but leaves the unprivileged worker unable to
# bind(): creating a socket needs write on the *directory*, and we are
# not granting that on a directory that also holds the root-owned auth
# socket.
#
# So the worker gets its own subdirectory, group-writable by faceid and
# nothing else. It can create and replace vision.sock in there and
# cannot touch anything at /run/faceid-nim level. The daemon is root,
# so it can still connect in either direction.
RuntimeDirectory=faceid-nim
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/install -d -o root -g faceid -m 0770 /run/faceid-nim/worker

# Runs as root because it must authenticate a user before that user's
# session exists. Everything not needed for that is taken away.
ProtectSystem=strict
# /etc/faceid-nim is writable because SetSettings persists there;
# ProtectSystem=strict would otherwise make every settings change fail
# at the last step, after the polkit prompt has already succeeded.
ReadWritePaths=/var/lib/faceid-nim /var/log/faceid-nim /run/faceid-nim /etc/faceid-nim /etc/pam.d
StateDirectory=faceid-nim
# 0711: traverse-only. The unprivileged vision worker must be able to
# reach models/ (installed 0755) but must never list the root, read
# master.key (0600) or enter users/ (0700). The daemon re-asserts this
# in Store::open so a restart cannot silently widen it.
StateDirectoryMode=0711
LogsDirectory=faceid-nim
ConfigurationDirectory=faceid-nim
ConfigurationDirectoryMode=0755
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
UMask=0077

[Install]
WantedBy=multi-user.target
